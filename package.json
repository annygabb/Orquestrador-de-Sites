{
  "name": "orquestrador-de-sites",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:skills": "node scripts/validate-skills.mjs",
    "test:turnstile": "node --experimental-transform-types --test tests/turnstile.test.mjs",
    "test:selection": "node --experimental-transform-types --test tests/selection-prompt.test.mjs tests/catalog-resources.test.mjs tests/panel-layout.test.mjs",
    "test:billing": "node --experimental-transform-types --test tests/billing.test.mjs",
    "test:security": "node --experimental-transform-types --test tests/security.test.mjs",
    "test:marketing": "node --test tests/marketing-hero.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:turnstile && npm run test:selection && npm run test:billing && npm run test:security && npm run test:marketing"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "mcp-handler": "1.1.0",
    "next": "16.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "typescript": "^5.9"
  }
}
