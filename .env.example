BASE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Supabase: chaves públicas no navegador; service role somente no servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas: use sandbox até concluir os testes. Nunca use a chave da API como token do webhook.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Resend: exige domínio verificado para produção.
RESEND_API_KEY=
EMAIL_FROM="Orquestrador de Sites <contato@seu-dominio.com>"

# Vercel Cron chama /api/cron/subscriptions com Bearer CRON_SECRET.
CRON_SECRET=

# Cloudflare Turnstile: crie um widget para o domínio do projeto.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost

# GitHub App instalada somente no repositório do Orquestrador.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_REPOSITORY=annygabb/Orquestrador-de-Sites
GITHUB_BASE_BRANCH=main

# Domínios HTTPS aceitos como fonte. Separe outros domínios confiáveis por vírgula.
SKILL_SOURCE_HOSTS=github.com,www.github.com,gist.github.com
